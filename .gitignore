# Local runs and captures; the server keeps no state of its own.
*.log
*.out

# Windows PowerShell transcript / module artefacts
*.transcript

# Editor and OS droppings — a published repo should not carry either.
.DS_Store
Thumbs.db
desktop.ini
*.swp

# A macOS tarball carries one of these beside every file (COPYFILE_DISABLE=1 avoids it).
._*
